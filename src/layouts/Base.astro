---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "insature",
  description = "Notes and thoughts.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a class="wordmark" href="/">insature</a>
      <nav aria-label="Primary navigation">
        <a href="/notes/">notes</a>
        <a href="/about/">about</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>Work in progress. (c) Paul Luis Röhl</footer>
  </body>
</html>

<style is:global>
  :root {
    color: #20271f;
    background: #f7f4ed;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 18px;
    line-height: 1.6;
  }

  * { box-sizing: border-box; }

  body { margin: 0; }

  header, main, footer {
    width: min(100% - 2.5rem, 46rem);
    margin-inline: auto;
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-block: 2rem 4rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
  }

  .wordmark {
    color: inherit;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  nav { display: flex; gap: 1rem; }

  a { color: #315a47; text-underline-offset: 0.16em; }
  a:hover { color: #a34d2f; }

  h1, h2 { color: #172518; line-height: 1.1; }
  h1 { font-size: clamp(2.5rem, 9vw, 5rem); letter-spacing: -0.055em; margin: 0; }
  h2 { font-size: 1.4rem; margin: 0; }

  footer {
    border-top: 1px solid #d9d2c5;
    color: #6d7369;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    margin-top: 6rem;
    padding-block: 1.5rem 3rem;
  }

  @media (max-width: 34rem) {
    header { padding-block: 1.4rem 3rem; }
  }
</style>
