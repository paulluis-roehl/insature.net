---
import Base from "../layouts/Base.astro";
import { Content, frontmatter } from "../content/about.md";
import "../styles/prose.css";
import "../styles/temml.css";
---

<Base title="About | insature" description={frontmatter.description}>
  <article>
    <p class="meta-text">about me</p>
    <h1>{frontmatter.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  h1 { font-size: clamp(2rem, 4vw, 2.6rem); }

  :global(.prose) { display: flow-root; }

  :global(.prose .about-portrait) {
    float: left;
    width: min(16rem, 55%);
    height: auto;
    margin: 0 1.75rem 1.25rem 0;
    border-radius: 1rem;
  }
</style>
