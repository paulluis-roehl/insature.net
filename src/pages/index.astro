---
import Base from "../layouts/Base.astro";
import NoteList from "../components/NoteList.astro";
import { notes, sortByModified } from "../lib/notes.ts"

// get the 3 most recent notes
const recentNotes = sortByModified(notes).slice(0, 3);
---

<Base title="Home | insature" description="Overview.">
  <section class="intro">
    <p class="meta-text">home</p>
    <h1>Insature</h1>
    <p class="lede">A workbench, a quick reference and an archive.</p>
  </section>

  <section aria-labelledby="recent-notes">
    <div class="section-heading">
      <h2 id="recent-notes">Recent activity</h2>
      <a class="meta-text" href="/notes/">all notes</a>
    </div>
    <NoteList notes={recentNotes} />
  </section>
</Base>

<style>
  .intro { margin-bottom: 5rem; max-width: 40rem; }
  .lede { max-width: 33rem; }
  .section-heading { align-items: baseline; display: flex; justify-content: space-between; margin-bottom: 0.8rem; }
</style>
