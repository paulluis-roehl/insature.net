---
import Base from "../layouts/Base.astro";
import { notes, sortByModified } from "../content/content.ts"

// get the 3 most recent notes
const recentNotes = sortByModified(notes).slice(0, 3);
---

<Base title="Home | insature" description="Overview.">
  <section class="intro">
    <p class="eyebrow">home</p>
    <h1>Insature</h1>
    <p class="lede">A workbench, a quick reference and an archive.</p>
  </section>

  <section aria-labelledby="recent-notes">
    <div class="section-heading">
      <h2 id="recent-notes">Recent activity</h2>
      <a href="/notes/">all notes</a>
    </div>
    <ul class="notes">
          {recentNotes.map((note) => (
        <li>
          <a href={`/notes/${note.id}/`}>
            <span>{note.data.created.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}</span>
            <strong>{note.data.title}</strong>
            {note.data.description && <p>{note.data.description}</p>}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .intro { margin-bottom: 5rem; max-width: 40rem; }
  .eyebrow, .section-heading a {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }
  .lede { font-size: 1.25rem; max-width: 33rem; }
  .section-heading { align-items: baseline; display: flex; justify-content: space-between; margin-bottom: 0.8rem; }
  .notes { border-top: 1px solid #d9d2c5; list-style: none; margin: 0; padding: 0; }
  .notes li { border-bottom: 1px solid #d9d2c5; }
  .notes a { display: block; padding-block: 1.2rem; text-decoration: none; }
  .notes strong { color: #20271f; display: block; font-size: 1.3rem; margin-top: 0.1rem; }
  .notes p { color: #6d7369; margin: 0.1rem 0 0; }
</style>
