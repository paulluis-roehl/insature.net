---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { notes } from "../../content/content.ts"
import "../../styles/prose.css";
import "../../styles/temml.css";


export async function getStaticPaths() {
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const date = note.data.created.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base title={`${note.data.title} | insature`} description={note.data.description}>
  <article>
    <p class="meta">{date} · note</p>
    <h1>{note.data.title}</h1>
    {note.data.description && <p class="lede">{note.data.description}</p>}
    <div class="prose">
      <Content />
    </div>
    <p><a href="/notes/">Back to notes</a></p>
  </article>
</Base>

<style>
  article { max-width: 39rem; }
  .meta { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--font-size-small); letter-spacing: var(--letter-spacing-wide); text-transform: uppercase; }
  .lede { font-size: 1.35rem; line-height: 1.45; margin-block: 2rem; }
</style>
