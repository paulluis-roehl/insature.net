---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { notes } from "../../content/content.ts"
import "../../styles/temml.css";


export async function getStaticPaths() {
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const date = note.data.created.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base title={`${note.data.title} | insature`} description={note.data.description}>
  <article>
    <p class="meta">{date} · note</p>
    <h1>{note.data.title}</h1>
    {note.data.description && <p class="lede">{note.data.description}</p>}
    <Content />
    <p><a href="/notes/">Back to notes</a></p>
  </article>
</Base>

<style>
  article { max-width: 39rem; }
  article :global(img) { display: block; max-width: 100%; height: auto; margin-inline: auto; }
  article :global(:not(pre) > code) { font-size: 0.92em; }
  article :global(table) {
    border-collapse: collapse;
    display: block;
    margin-block: 2.5rem 2rem;
    max-width: 100%;
    overflow-x: auto;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  article :global(th), article :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.45rem 0.9rem;
    text-align: left;
    vertical-align: top;
  }
  article :global(thead th) {
    background: var(--color-surface-strong);
    color: var(--color-heading);
    font-family: var(--font-mono);
    font-size: var(--font-size-small);
    font-weight: 700;
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }
  article :global(tbody tr:nth-child(even)) { background: var(--color-surface); }
  .meta { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--font-size-small); letter-spacing: var(--letter-spacing-wide); text-transform: uppercase; }
  .lede { font-size: 1.35rem; line-height: 1.45; margin-block: 2rem; }
</style>
