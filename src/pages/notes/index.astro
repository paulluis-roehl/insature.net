---
import Base from "../../layouts/Base.astro";
import NoteList from "../../components/NoteList.astro";
import { notes, sortByModified } from "../../content/content.ts"
---

<Base title="Notes | insature" description="Notes on various topics.">
  <p class="eyebrow">all notes</p>
  <h1>Notes</h1>
  <article>
    <NoteList notes={sortByModified(notes)} />
  </article>
</Base>

<style>
  .eyebrow { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--font-size-small); letter-spacing: var(--letter-spacing-wide); text-transform: uppercase; }
  article { margin-top: 2rem; padding-top: 1.2rem; }
</style>
