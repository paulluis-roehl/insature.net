---
import Base from "../../layouts/Base.astro";
import ContentList from "../../components/ContentList.astro";
import { notes, sortByModified } from "../../lib/content.ts";

const sortedNotes = sortByModified(notes);
---

<Base title="Notes | insature" description="Things I study.">
  <p class="meta-text">all notes</p>
  <h1>Notes</h1>
  <p class="lede">Things I study.</p>
  <section class="collection-list" aria-label="Notes">
    <ContentList entries={sortedNotes} />
  </section>
</Base>
