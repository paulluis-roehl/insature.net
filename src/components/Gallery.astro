---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import "photoswipe/style.css";

export interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  position?: string;
}

interface Props {
  images: GalleryImage[];
  layout: number[][];
  size?: number;
  label?: string;
  caption?: string;
}

const {
  images,
  layout,
  size = 1,
  label = "Image gallery",
  caption,
} = Astro.props;

if (!Number.isFinite(size) || size <= 0 || size > 1) {
  throw new Error("Gallery size must be greater than 0 and no greater than 1.");
}

const columnCount = layout[0]?.length ?? 0;

if (
  !columnCount ||
  layout.some((row) => row.length !== columnCount)
) {
  throw new Error("A Gallery layout must have equally sized, non-empty rows.");
}

const invalidIndex = layout.flat().find(
  (index) => !Number.isInteger(index) || index < 0 || index > images.length,
);

if (invalidIndex !== undefined) {
  throw new Error(`Gallery layout index ${invalidIndex} is outside the range 0-${images.length}.`);
}

const selectedImages = new Set(layout.flat().filter((index) => index > 0));
if (selectedImages.size !== images.length) {
  throw new Error("A Gallery layout must include every image at least once.");
}

const galleryStyle = [
  `grid-template-columns: repeat(${columnCount}, minmax(0, 1fr))`,
  `grid-template-rows: repeat(${layout.length}, minmax(0, 1fr))`,
  `grid-template-areas: ${layout.map((row) => `"${row.map((index) => index === 0 ? "." : `image-${index}`).join(" ")}"`).join(" ")}`,
  `aspect-ratio: ${columnCount} / ${layout.length}`,
].join("; ");
---

<figure class="gallery-frame" style={`width: ${size * 100}%`}>
  <div
    class="gallery"
    style={galleryStyle}
    data-photoswipe-gallery
    role="group"
    aria-label={label}
  >
    {images.map((image, index) => (
      <div
        class="gallery__item"
        style={`grid-area: image-${index + 1}`}
      >
        <a
          class="gallery__link"
          href={image.src.src}
          data-pswp-width={image.src.width}
          data-pswp-height={image.src.height}
          data-pswp-caption={image.caption}
          aria-label={`Enlarge: ${image.alt}`}
        >
          <Image
            class="gallery__image"
            src={image.src}
            alt={image.alt}
            widths={[320, 640, 960, 1280]}
            sizes="(max-width: 34rem) calc(100vw - 2.5rem), 39rem"
            style={image.position ? `object-position: ${image.position}` : undefined}
          />
        </a>
      </div>
    ))}
  </div>
  {caption && <figcaption class="gallery-caption">{caption}</figcaption>}
</figure>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";

  function initializeGalleries() {
    document
      .querySelectorAll<HTMLElement>("[data-photoswipe-gallery]:not([data-photoswipe-ready])")
      .forEach((gallery) => {
        gallery.dataset.photoswipeReady = "true";

        const lightbox = new PhotoSwipeLightbox({
          gallery,
          children: "a",
          pswpModule: () => import("photoswipe"),
        });

        lightbox.on("uiRegister", () => {
          lightbox.pswp?.ui?.registerElement({
            name: "caption",
            order: 9,
            isButton: false,
            appendTo: "root",
            html: "",
            onInit: (element, pswp) => {
              pswp.on("change", () => {
                const trigger = pswp.currSlide?.data.element as HTMLElement | undefined;
                element.textContent = trigger?.dataset.pswpCaption ?? "";
              });
            },
          });
        });

        lightbox.init();
      });
  }

  initializeGalleries();
  document.addEventListener("astro:page-load", initializeGalleries);
</script>

<style>
  .gallery-frame {
    margin: 2.5rem auto;
  }

  .gallery {
    display: grid;
    gap: 0.75rem;
  }

  .gallery__item {
    min-width: 0;
    margin: 0;
  }

  .gallery__link {
    display: block;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    background: var(--color-surface-strong);
  }

  .gallery__image {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
    transition: opacity 160ms ease;
  }

  .gallery__link:hover .gallery__image {
    opacity: 0.86;
  }

  .gallery__link:focus-visible {
    outline-offset: 0.25rem;
  }

  .gallery-caption {
    margin-top: 0.45rem;
  }

  :global(.pswp__caption) {
    position: absolute;
    bottom: 0;
    left: 50%;
    max-width: min(39rem, calc(100% - 2.5rem));
    padding: 0.6rem 0.85rem;
    transform: translateX(-50%);
    color: white;
    background: rgb(0 0 0 / 65%);
    font-family: var(--font-body);
    text-align: center;
  }

  :global(.pswp__caption:empty) {
    display: none;
  }

  @media (max-width: 34rem) {
    .gallery {
      grid-template-columns: 1fr !important;
      grid-template-areas: none !important;
      grid-template-rows: none !important;
      aspect-ratio: auto !important;
    }

    .gallery__item {
      grid-area: auto !important;
    }

    .gallery__link,
    .gallery__image {
      height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__image {
      transition: none;
    }
  }
</style>
