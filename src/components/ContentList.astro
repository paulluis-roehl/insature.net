---
import type { CollectionEntry } from "astro:content";

interface Props {
  entries: CollectionEntry<"notes" | "output">[];
}

const { entries } = Astro.props;
---

<ul class="entries">
  {entries.map((entry) => (
    <li>
      <a href={`/${entry.collection}/${entry.id}/`}>
        <span class="meta-text">{entry.data.created.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}</span>
        <strong>{entry.data.title}</strong>
        {entry.data.description && <p>{entry.data.description}</p>}
      </a>
    </li>
  ))}
</ul>

<style>
  .entries {
    border-top: 1px solid var(--color-border);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entries li { border-bottom: 1px solid var(--color-border); }
  .entries a { display: block; padding-block: 1.2rem; text-decoration: none; }
  .entries strong {
    color: var(--color-text);
    display: block;
    font-size: 1.3rem;
    margin-top: 0.1rem;
  }
  .entries p { color: var(--color-muted); margin: 0.1rem 0 0; }
</style>
